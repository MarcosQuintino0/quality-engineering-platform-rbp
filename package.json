{
  "name": "quality-engineering-platform-rbp",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de testes automatizados para o Restful Booker Platform",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:contracts": "playwright test --project=contracts",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:firefox": "playwright test --project=ui-firefox",
    "test:integration": "playwright test --project=integration",
    "test:database": "playwright test --project=database",
    "test:a11y": "playwright test --project=accessibility",
    "test:smoke": "playwright test --grep @smoke",
    "test:list": "playwright test --list",
    "env:up": "node scripts/start-environment.js",
    "env:down": "node scripts/stop-environment.js",
    "env:wait": "node scripts/wait-for-services.js",
    "env:status": "node scripts/wait-for-services.js --once",
    "db:query": "node scripts/db-query.js",
    "perf:smoke": "node scripts/run-k6.js smoke",
    "perf:load": "node scripts/run-k6.js load",
    "perf:stress": "node scripts/run-k6.js stress",
    "perf:spike": "node scripts/run-k6.js spike",
    "perf:soak": "node scripts/run-k6.js soak",
    "allure:generate": "node scripts/allure-metadata.js && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
