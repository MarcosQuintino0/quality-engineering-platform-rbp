# ---------------------------------------------------------------------------
# Configuracao do ambiente de testes. Copie para .env e ajuste se necessario.
# Nenhum segredo real deve ser commitado neste repositorio.
# ---------------------------------------------------------------------------

# Frontend do SUT, alvo dos testes de interface.
BASE_URL=http://localhost:8080

# Microsservicos, alvo dos testes de API e de contrato. Cada servico publica
# seus endpoints sob um context path com o proprio nome (ex.: :3001/room).
AUTH_URL=http://localhost:3004
BOOKING_URL=http://localhost:3000
ROOM_URL=http://localhost:3001
BRANDING_URL=http://localhost:3002
MESSAGE_URL=http://localhost:3006
REPORT_URL=http://localhost:3005

# Credenciais administrativas. Sao as credenciais publicas e fixas do SUT,
# documentadas no README oficial do Restful Booker Platform.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Acesso somente leitura aos bancos H2 expostos em modo servidor (dbServer=true).
DB_ENABLED=true
DB_HOST=localhost
DB_BOOKING_PORT=9090
DB_AUTH_PORT=9091
DB_BRANDING_PORT=9092
DB_MESSAGE_PORT=9093
DB_ROOM_PORT=9094
DB_USER=user
DB_PASSWORD=password

# Semente determinista para geracao de massa de dados.
DATA_SEED=20260903

# Guarda de seguranca: operacoes destrutivas e de carga so rodam contra hosts
# desta lista. Nunca inclua automationintesting.online aqui.
ALLOWED_TEST_HOSTS=localhost,127.0.0.1,host.docker.internal
